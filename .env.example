# ========================================================
# ZUDIO Online Shopping Management System - Environment Variables
# ========================================================
# Copy this file to .env and fill in your values for production deployment

# Application Port (default: 8080)
PORT=8080

# Environment Mode (production / development)
APP_ENV=production

# Database Connection URL (MySQL 8 / MariaDB compatible)
# For local Docker compose, service host is 'mysql'
# For managed clouds (Railway, Aiven), replace with provider connection string
DB_URL=jdbc:mysql://mysql:3306/zudio_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# Database User & Password
DB_USER=zudio_user
DB_PASSWORD=ZudioStrongDbPassword2026!

# Cryptographic Token Signing Secret (min 32 characters, required in production)
TOKEN_SECRET=replace_with_a_super_strong_cryptographic_secret_min_32_characters_1234567890

# Initial Administrator Credentials (seeded on first startup)
ADMIN_EMAIL=admin@zudio.in
ADMIN_PASSWORD=AdminSecurePassword2026!

# CORS Allowed Origin (e.g. https://yourfrontend.com or * for open API)
ALLOWED_ORIGIN=*
